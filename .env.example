# Only needed for --gen-questions with a hosted model. Ollama needs no key.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Where parser environments and models are stored (default: ~/.cache/parsearena)
# PARSEARENA_HOME=

# Marker 2.x OCR on machines without an NVIDIA GPU needs llama.cpp's llama-server
# LLAMA_CPP_BINARY=/path/to/llama-server
